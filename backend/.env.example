# Copy to .env and fill in. The app runs fully without AI keys (heuristic mode).
SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Production (set these on Railway, NOT locally) ----
# DEBUG=False
# SECRET_KEY=<a long random string>
# DATABASE_URL=<provided automatically when you add a Railway Postgres>
# ALLOWED_HOSTS is auto-filled from Railway's domain; add custom hosts here.
# CORS_ALLOWED_ORIGINS=https://gamesquad-three.vercel.app
# CSRF_TRUSTED_ORIGINS=https://gamesquad-three.vercel.app
# MEDIA_ROOT=/data/media   # path of the Railway persistent volume mount

# AI providers — Groq is tried first, then OpenRouter.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
